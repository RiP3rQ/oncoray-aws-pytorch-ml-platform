{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "not": {
    "anyOf": [
      {
        "required": ["modelRuntimeDefaults"]
      },
      {
        "required": ["modelRuntimes"]
      }
    ]
  },
  "properties": {
    "global": {
      "type": "object"
    },
    "workloads": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/workload"
      },
      "not": {
        "anyOf": [
          {
            "required": ["model-service-effnetb0"]
          },
          {
            "required": ["model-service-vitb16"]
          }
        ]
      }
    },
    "migrations": {
      "$ref": "#/definitions/migrations"
    }
  },
  "required": ["global", "workloads", "migrations"],
  "definitions": {
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "externalSecret": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "targetName": {
          "type": "string"
        },
        "data": {
          "type": "array"
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "serviceAccount": {
          "$ref": "#/definitions/serviceAccount"
        },
        "env": {
          "$ref": "#/definitions/stringMap"
        },
        "externalSecret": {
          "$ref": "#/definitions/externalSecret"
        }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "command": {
          "type": "array"
        },
        "env": {
          "$ref": "#/definitions/stringMap"
        },
        "envFromSecrets": {
          "type": "array"
        },
        "serviceAccount": {
          "$ref": "#/definitions/serviceAccount"
        }
      },
      "required": ["enabled", "image", "command"]
    }
  }
}
