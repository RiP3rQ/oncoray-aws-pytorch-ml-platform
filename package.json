{
  "name": "with-tailwind",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "check-types": "turbo run check-types",
    "check-types:python": "turbo run check-types --filter=fastapi-core-api --filter=pytorch-engine",
    "format": "turbo run format",
    "infra:validate": "terraform -chdir=infra/terraform/environments/prod validate",
    "prod:release": "powershell -ExecutionPolicy Bypass -File infra/scripts/release-prod.ps1",
    "test:e2e": "turbo run test:e2e --filter=astro-web",
    "start-database": "turbo run start-database",
    "pre-commit": "node ./node_modules/lint-staged/bin/lint-staged.js --verbose --concurrent false",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.0",
    "lint-staged": "^15.5.0",
    "prettier": "^3.6.0",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "turbo": "^2.9.3"
  },
  "lint-staged": {
    "*.py": "node scripts/run-ruff-precommit.mjs",
    "*.{ts,tsx,js,jsx,astro}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
