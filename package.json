{
  "name": "with-tailwind",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "check-types": "turbo run check-types",
    "check-types:python": "turbo run check-types --filter=fastapi-core-api --filter=pytorch-engine --filter=model-service",
    "contract:openapi": "bun run --cwd apps/api openapi:export -- ../../tmp/openapi.json",
    "contract:generate": "bun run contract:openapi && bunx openapi-typescript tmp/openapi.json -o apps/astro-web/src/lib/generated/api-types.ts",
    "contract:check": "bun run contract:generate && git diff --exit-code -- apps/astro-web/src/lib/generated/api-types.ts",
    "format": "turbo run format",
    "infra:bootstrap": "powershell -ExecutionPolicy Bypass -File infra/scripts/bootstrap-tools.ps1",
    "infra:bootstrap:install": "powershell -ExecutionPolicy Bypass -File infra/scripts/bootstrap-tools.ps1 -Install",
    "infra:terraform:init": "terraform -chdir=infra/terraform/environments/prod init -backend=false",
    "infra:test:terraform:workload-identities": "terraform -chdir=infra/terraform/modules/workload-identities test",
    "infra:validate": "powershell -ExecutionPolicy Bypass -File infra/scripts/validate-local.ps1",
    "infra:validate:helm": "powershell -ExecutionPolicy Bypass -File infra/scripts/validate-local.ps1 -CheckHelm -RequireHelm",
    "prod:deploy:backend": "powershell -ExecutionPolicy Bypass -File infra/scripts/deploy-prod.ps1",
    "prod:destroy": "powershell -ExecutionPolicy Bypass -File infra/scripts/destroy-prod.ps1",
    "test:e2e": "turbo run test:e2e --filter=astro-web",
    "start-database": "turbo run start-database",
    "pre-commit": "node ./node_modules/lint-staged/bin/lint-staged.js --verbose --concurrent false",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.0",
    "lint-staged": "^15.5.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.6.0",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "turbo": "^2.9.3"
  },
  "lint-staged": {
    "*.py": "node scripts/run-ruff-precommit.mjs",
    "*.{ts,tsx,js,jsx,astro}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
