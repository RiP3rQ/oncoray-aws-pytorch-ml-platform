{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": [
        "^lint:fix"
      ]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "format": {},
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "test:coverage": {
      "dependsOn": [
        "^build"
      ]
    },
    "test:e2e": {
      "cache": false
    },
    "test:e2e:headed": {
      "cache": false
    },
    "test:e2e:ui": {
      "cache": false
    },
    "test:e2e:debug": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start-database": {
      "cache": false,
      "persistent": true
    }
  }
}
