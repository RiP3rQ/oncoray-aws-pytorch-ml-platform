PUBLIC_API_BASE_URL=https://api.example.com

# Sentry browser error reporting.
# Use a dev/staging Sentry project DSN for pre-deploy smoke tests.
PUBLIC_SENTRY_DSN=
PUBLIC_APP_ENVIRONMENT=development
PUBLIC_APP_RELEASE=dev-test-local
PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1.0

# Sentry source map upload during `bun run build`.
# Keep these private. Do not expose them with PUBLIC_ prefixes.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
