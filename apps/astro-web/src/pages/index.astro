---
import Layout from '../layouts/Layout.astro';
import Dashboard from '../components/Dashboard.tsx';
---

<Layout
	title="OncoRay Workspace"
	description="Upload X-ray images, review AI-assisted risk flags, and manage patient imaging workflows."
>
	<Dashboard client:load />
</Layout>

<style>
	/* Topbar and dashboard styles are in Dashboard.tsx inline + global.css */
	.topbar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 18px 22px;
		border-radius: 28px;
	}

	.brand {
		margin: 0;
		font-family: "Syne", sans-serif;
		font-size: 1.2rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.topnote {
		margin: 4px 0 0;
		color: var(--muted);
		font-size: 0.76rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.app-frame {
		padding-bottom: 40px;
	}

	.section-label {
		margin: 0;
		color: var(--muted);
		font-size: 0.76rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}
</style>