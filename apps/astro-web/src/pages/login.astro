---
import Layout from "../layouts/Layout.astro";
import LoginForm from "../components/LoginForm.tsx";
---

<Layout
  title="Log In | OncoRay"
  description="Access OncoRay to upload chest X-rays and review pneumonia classification output."
>
  <div
    class="mx-auto flex min-h-dvh w-full max-w-[56rem] px-4 py-4 sm:px-6 lg:px-8"
  >
    <div
      class="grid min-h-[calc(100dvh-2rem)] w-full items-center gap-6 lg:min-h-[calc(100dvh-3rem)] lg:grid-cols-[minmax(0,1.05fr)_minmax(22.5rem,28.75rem)] lg:gap-8"
    >
      <section
        class="motion-safe:animate-in motion-safe:fade-in motion-safe:slide-in-from-bottom-2 flex min-w-0 flex-col justify-center motion-safe:duration-200 lg:min-h-[38rem]"
      >
        <span
          class="text-accent mb-2 block text-sm leading-none font-bold tracking-[0.05em] uppercase"
        >
          Protected workspace
        </span>
        <h1
          class="text-foreground font-mono text-[clamp(1.5rem,5vw,2.375rem)] leading-[1.5] font-bold"
        >
          Step back into chest X-ray review.
        </h1>
        <p
          class="text-muted-foreground mt-4 max-w-[42ch] text-base leading-[1.5]"
        >
          Sign in to continue reviewing uploaded chest X-rays, model confidence,
          and case notes. Keep every study flowing through one clean,
          accountable workspace.
        </p>

        <div class="mt-8 grid gap-3 sm:max-w-[32rem]">
          <div
            class="border-border bg-card rounded-[4px] border px-5 py-4 transition-colors duration-150 hover:border-[var(--color-opencode-border-outline)]"
          >
            <strong class="text-foreground font-bold">Default model</strong>
            <span
              class="text-muted-foreground mt-1 block text-sm leading-[1.5]"
            >
              Chest X-ray pneumonia classifier online
            </span>
          </div>
          <div
            class="border-border bg-card rounded-[4px] border px-5 py-4 transition-colors duration-150 hover:border-[var(--color-opencode-border-outline)]"
          >
            <strong class="text-foreground font-bold">Review policy</strong>
            <span
              class="text-muted-foreground mt-1 block text-sm leading-[1.5]"
            >
              Model output supports review, not diagnosis
            </span>
          </div>
        </div>
      </section>

      <section
        class="border-border bg-card motion-safe:animate-in motion-safe:fade-in motion-safe:slide-in-from-bottom-2 rounded-[4px] border p-6 motion-safe:duration-200 sm:p-8 lg:min-h-[34rem]"
      >
        <div>
          <p
            class="text-muted-foreground text-sm leading-none font-bold tracking-[0.05em] uppercase"
          >
            Log in
          </p>
          <h2
            class="text-foreground mt-2 font-mono text-[1.375rem] leading-[1.5] font-bold"
          >
            Resume an active imaging review.
          </h2>
        </div>

        <LoginForm client:load />
      </section>
    </div>
  </div>
</Layout>
