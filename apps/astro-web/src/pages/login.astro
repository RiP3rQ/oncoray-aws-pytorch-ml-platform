---
import Layout from "../layouts/Layout.astro";
import LoginForm from "../components/LoginForm.tsx";
---

<Layout
  title="Log In | OncoRay"
  description="Access OncoRay to upload chest X-rays and review pneumonia classification output."
>
  <div class="page-shell">
    <div class="frame auth-layout">
      <section class="auth-copy animate-rise h-[600px]">
        <span class="eyebrow">Protected workspace</span>
        <h1 class="headline">Step back into chest X-ray review.</h1>
        <p class="lede">
          Sign in to continue reviewing uploaded chest X-rays, model confidence,
          and case notes. Keep every study flowing through one clean,
          accountable workspace.
        </p>

        <div class="signal-strip">
          <div>
            <strong>Default model</strong>
            <span>Chest X-ray pneumonia classifier online</span>
          </div>
          <div>
            <strong>Review policy</strong>
            <span>Model output supports review, not diagnosis</span>
          </div>
        </div>
      </section>

      <section class="auth-card flat-card animate-rise h-[525px] delay-2">
        <div class="card-top">
          <p class="section-label">Log in</p>
          <h2>Resume an active imaging review.</h2>
        </div>

        <LoginForm client:load />
      </section>
    </div>
  </div>
</Layout>
