---
import Layout from "../layouts/Layout.astro";
import RegisterForm from "../components/RegisterForm.tsx";
---

<Layout
  title="Register | OncoRay"
  description="Create an OncoRay account to begin uploading chest X-rays and reviewing pneumonia classification output."
>
  <div class="page-shell">
    <div class="frame register-layout">
      <section class="register-card flat-card animate-rise">
        <div class="card-header">
          <p class="section-label">Create account</p>
          <h1>Open a secure lane for incoming chest X-rays.</h1>
          <p>
            Set up your workspace in seconds. We keep the flow minimal here:
            just email and password, then you're ready to upload chest X-rays
            and review model output.
          </p>
        </div>

        <RegisterForm client:load />
      </section>

      <section class="register-copy animate-rise delay-2">
        <span class="eyebrow">Rapid onboarding</span>
        <h2 class="headline">
          A calmer front door for a high-stakes workflow.
        </h2>
        <p class="lede">
          OncoRay is currently configured around chest X-ray pneumonia review.
          The interface surfaces predicted class, confidence signals, and
          follow-up checkpoints without pretending the model replaces clinical
          judgment.
        </p>

        <div class="feature-grid">
          <div>
            <strong>Chest X-ray intake</strong>
            <span>Upload chest X-rays for the current pneumonia workflow.</span>
          </div>
          <div>
            <strong>Classification summary</strong>
            <span>Review predicted class and confidence for each upload.</span>
          </div>
          <div>
            <strong>Audit-friendly flow</strong>
            <span>Every model result stays tied to its image reference.</span>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>
