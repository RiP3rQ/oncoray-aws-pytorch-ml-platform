---
import '../styles/global.css';
import { Toaster } from '../components/ui/sonner.tsx';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'OncoRay',
	description = 'AI-assisted X-ray screening workspace for image uploads and risk reviews.'
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#201d1d" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Prevent FOUC: ensure dark class is set before paint -->
		<script is:inline>
			if (!document.documentElement.classList.contains('dark')) {
				document.documentElement.classList.add('dark');
			}
		</script>

		<!-- Preload critical fonts (IBM Plex Mono — Berkeley Mono open-source fallback) -->
		<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
	</head>
	<body>
		<slot />
		<Toaster client:load />
	</body>
</html>