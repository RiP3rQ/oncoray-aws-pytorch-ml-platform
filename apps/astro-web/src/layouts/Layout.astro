---
import "@repo/ui/globals.css";
import { Toaster } from "../components/ui/sonner.tsx";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "OncoRay",
  description = "AI-assisted imaging workspace for chest X-ray uploads and pneumonia classification review.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#201d1d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-background text-foreground min-h-dvh font-mono antialiased">
    <slot />
    <Toaster client:load />
  </body>
</html>
