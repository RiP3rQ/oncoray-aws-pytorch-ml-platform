CORE_API_ENVIRONMENT="development"
CORE_API_LOG_LEVEL="INFO"
CORE_API_DATABASE_URL="sqlite+aiosqlite:///./core_api.db"
CORE_API_JWT_SECRET="change-me-before-production"
CORE_API_ACCESS_TOKEN_TTL_MINUTES="15"
CORE_API_CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"
CORE_API_AUTH_RATE_LIMIT_MAX_REQUESTS="5"
CORE_API_AUTH_RATE_LIMIT_WINDOW_SECONDS="60"
