# General settings
APP_HTTP_PROTOCOL="http"
APP_NAME="Core API"
APP_ENVIRONMENT="development"
APP_LOG_LEVEL="INFO"

# PostgreSQL settings
POSTGRES_SERVER="localhost"
POSTGRES_PORT="5433"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="12345678"
POSTGRES_DB="pytorch-model"

# Redis settings
REDIS_HOST="localhost"
REDIS_PORT="6379"

# JWT settings
JWT_SECRET="change-me-before-production"
JWT_ALGORITHM="HS256"

# Email settings
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=
MAIL_SERVER=
MAIL_PORT=

# AWS S3 settings (for image uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION="us-east-1"
S3_BUCKET_NAME="model-predictions"

# Model Runtime Host
MODEL_SERVICE_URL="http://127.0.0.1:8001"

# Worker / Celery settings
SQS_QUEUE_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_QUEUE_NAME=

# Other settings
ACCESS_TOKEN_TTL_MINUTES="15"
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:4321"
AUTH_RATE_LIMIT_MAX_REQUESTS="5"
AUTH_RATE_LIMIT_WINDOW_SECONDS="60"
