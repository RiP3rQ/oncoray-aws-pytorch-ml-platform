# General settings
APP_HTTP_PROTOCOL="http"
APP_NAME="Core API"
APP_ENVIRONMENT="development"
APP_LOG_LEVEL="INFO"
APP_DOMAIN="localhost:8000"
SCALAR_DOCS_ENABLED="true"

# PostgreSQL settings
POSTGRES_SERVER="localhost"
POSTGRES_PORT="5433"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="12345678"
POSTGRES_DB="pytorch-model"
CORE_API_DATABASE_URL=

# JWT settings
SECRET_KEY="change-me-before-production"
JWT_SECRET="change-me-before-production"
ALGORITHM="HS256"
JWT_ALGORITHM="HS256"

# Email settings
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=
MAIL_SERVER=
MAIL_PORT=
MAIL_STARTTLS="true"
MAIL_SSL_TLS="false"
USE_CREDENTIALS="true"
VALIDATE_CERTS="true"

# AWS S3 settings (for image uploads)
# Local-only static AWS credentials. Production uses IRSA.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION="us-east-1"
S3_BUCKET_NAME="model-predictions"
S3_UPLOAD_MODE="mock"

# Model Runtime Host
MODEL_SERVICE_URL="http://127.0.0.1:8001"
MODEL_SERVICE_TIMEOUT_SECONDS="30"

# OpenTelemetry local trace export.
# Start apps/api/compose.yaml, then open Jaeger at http://localhost:16686.
OTEL_ENABLED="true"
OTEL_SERVICE_NAME="core-api"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
OTEL_EXCLUDED_URLS="/livez,/readyz,/startupz,/health,/healthz"

# Other settings
ACCESS_TOKEN_TTL_MINUTES="15"
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:4321"
AUTH_RATE_LIMIT_MAX_REQUESTS="5"
AUTH_RATE_LIMIT_WINDOW_SECONDS="60"
EMAIL_VERIFICATION_TOKEN_TTL_HOURS="24"
