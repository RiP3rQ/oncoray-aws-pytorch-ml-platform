# App
APP_NAME=model-service
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO

# Model Runtime
# Supported slugs: effnetb0, vitb16
MODEL_SLUG=effnetb0
MODEL_ARTIFACT_PATH=/models/model.pth
MODEL_DEVICE=cpu
MODEL_NUM_THREADS=1
MODEL_CLASS_NAMES=NORMAL,PNEUMONIA
MODEL_STRICT_LOAD=true
MODEL_STARTUP_SMOKE_TEST=true

# Optional local artifact verification
MODEL_ARTIFACT_SHA256=

# Optional Hugging Face artifact source
# Required when APP_ENVIRONMENT=production:
# - HF_MODEL_REPOSITORY
# - HF_MODEL_FILENAME
HF_MODEL_REPOSITORY=
HF_MODEL_REVISION=main
HF_MODEL_FILENAME=
HF_TOKEN=

# Optional Torch compiler cache override.
# Set only if default cache location is not writable in your runtime.
TORCHINDUCTOR_CACHE_DIR=
