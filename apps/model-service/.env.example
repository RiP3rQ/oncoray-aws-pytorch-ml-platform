# App
APP_NAME=model-service
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO

# Model Runtime
# Supported slugs: effnetb0, vitb16
MODEL_SLUGS=effnetb0,vitb16
MODEL_SLUG=effnetb0
MODEL_ARTIFACT_PATH=/models/model.pth
EFFNETB0_MODEL_ARTIFACT_URL=https://huggingface.co/RiP3rQ/effnetb0/resolve/main/effnetb0/effnetb0_epoch_008.pth
VITB16_MODEL_ARTIFACT_URL=https://huggingface.co/RiP3rQ/vit_b_16/resolve/main/vit_b_16/vit_b_16_epoch_018.pth
MODEL_DEVICE=cpu
MODEL_NUM_THREADS=1
MODEL_CLASS_NAMES=NORMAL,PNEUMONIA
MODEL_STRICT_LOAD=true
MODEL_STARTUP_SMOKE_TEST=true

# Optional local artifact verification
MODEL_ARTIFACT_SHA256=

# Optional Hugging Face artifact source
# Defaults by MODEL_SLUG come from EFFNETB0_MODEL_ARTIFACT_URL and VITB16_MODEL_ARTIFACT_URL.
# Set HF_TOKEN if repos are private or gated.
# Set HF_MODEL_REPOSITORY/HF_MODEL_FILENAME only to override the URL-based source.
HF_MODEL_REPOSITORY=
HF_MODEL_REVISION=main
HF_MODEL_FILENAME=
HF_TOKEN=

# Optional Torch compiler cache override.
# Set only if default cache location is not writable in your runtime.
TORCHINDUCTOR_CACHE_DIR=
