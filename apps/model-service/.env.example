# App
APP_NAME=model-service
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO

# Model Runtime Host
MODEL_SLUGS=effnetb0,vitb16
MODEL_ARTIFACT_PATH=/models/model.pth
EFFNETB0_MODEL_ARTIFACT_URL=https://huggingface.co/RiP3rQ/effnetb0/resolve/main/effnetb0/effnetb0_epoch_008.pth
EFFNETB0_MODEL_ARTIFACT_SHA256=
VITB16_MODEL_ARTIFACT_URL=https://huggingface.co/RiP3rQ/vit_b_16/resolve/main/vit_b_16/vit_b_16_epoch_018.pth
VITB16_MODEL_ARTIFACT_SHA256=
MODEL_DEVICE=cpu
MODEL_NUM_THREADS=1
MODEL_CLASS_NAMES=NORMAL,PNEUMONIA
MODEL_STRICT_LOAD=true
MODEL_STARTUP_SMOKE_TEST=true

# Hugging Face
HF_TOKEN=
HF_USERNAME=RiP3rQ

# OpenTelemetry tracing.
# For local collector smoke tests, use an OTLP gRPC endpoint such as:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_ENABLED=true
OTEL_SERVICE_NAME=model-runtime-host
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXCLUDED_URLS=/livez,/readyz,/startupz
